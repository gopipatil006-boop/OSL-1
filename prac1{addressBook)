
#!/bin/bash

while true
do
    echo "1.Create  2.View  3.Insert  4.Delete  5.Modify  6.Exit"
    read ch

    case $ch in

    1)
        > address.txt
        echo "Enter name and mobile:"
        read name mobile
        echo "$name $mobile" >> address.txt
        ;;

    2)
        cat address.txt
        ;;

    3)
        echo "Enter name and mobile:"
        read name mobile
        echo "$name $mobile" >> address.txt
        ;;

    4)
        echo "Enter name to delete:"
        read name
        grep -v "^$name " address.txt > temp.txt
        mv temp.txt address.txt
        ;;

    5)
        echo "Enter old name:"
        read name
        grep -v "^$name " address.txt > temp.txt
        echo "Enter new name and mobile:"
        read newname mobile
        echo "$newname $mobile" >> temp.txt
        mv temp.txt address.txt
        ;;

    6)
        exit
        ;;

    *)
        echo "Invalid choice"
        ;;

    esac
done
